---
import "../styles/global.css";
import Navbar from "@/components/Navbar/Navbar.astro";
import Hero from "@/components/Hero.astro";
import FeatureHighlight from "@/components/FeatureHightlight/FeatureHighlight.astro";
import HowItWorks from "@/components/HowItWorks/HowItWorks.astro";
import WhyAllThingsGift from "@/components/WhyAllThingsGift/WhyAllThingsGift.astro";
import EventCreationSteps from "@/components/EventCreationSteps/EventCreationSteps.astro";
import GetStartedBanner from "@/components/GetStartedBanner.astro";
// Component Imports

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>AllThingsGift</title>
  </head>

  <body>
    <Navbar />
    <Hero />
    <FeatureHighlight />
    <div class="p-10 mb-20">
      <div class="flex flex-col gap-25 mt-10">
        <section
          class="grid md:grid-cols-[250px_minmax(300px,1fr)] gap-20 md:gap-10 items-center"
        >
          <HowItWorks />
          <!-- Actual App Image -->
          <EventCreationSteps />
        </section>
        <section
          class="flex gap-10 flex-col md:flex-row justify-center items-center"
        >
          <!-- Actual App Image -->
          <img src="/gifts.png" class="max-sm:w-full md:h-60 rounded-lg" />
          <!-- Actual App Image -->
          <WhyAllThingsGift />
          <!-- Testamonials -->
        </section>
        <section>
          <GetStartedBanner />
        </section>
      </div>
    </div>
  </body>
</html>

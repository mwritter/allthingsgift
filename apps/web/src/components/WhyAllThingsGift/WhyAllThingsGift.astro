---
import { ArrowRight, Check, CircleCheck } from "@lucide/astro";
import Badge from "../Badge.astro";
import { buttonVariants } from "@allthingsgift/ui/components/button";
---

<div class="flex flex-col gap-2 justify-self-center self-center">
  <Badge text="Why All Things Gift?" />
  <div class="max-w-75">
    <p class="text-xl font-bold leading-6">Less organizing.</p>
    <p class="text-xl font-bold">More celebrating.</p>
    <p class="text-xs">
      Say goodbye to spreadsheets and endless group chats. All Things Gift makes
      it easy to bring people together for the moments that matter.
    </p>
  </div>
  <ul class="text-xs flex flex-col gap-2">
    <li class="flex gap-5 items-center">
      <Check class="bg-primary rounded-full text-white p-1" size={20} />
      <p>Simple and intuitive</p>
    </li>
    <li class="flex gap-5 items-center">
      <Check class="bg-primary rounded-full text-white p-1" size={20} />
      <p>Flexible for any occasion</p>
    </li>
    <li class="flex gap-5 items-center">
      <Check class="bg-primary rounded-full text-white p-1" size={20} />
      <p>Free to get started</p>
    </li>
  </ul>
  <div class="mt-5">
    <a href="/" class={buttonVariants({ className: "px-5" })}>
      Get started free
      <ArrowRight />
    </a>
  </div>
</div>

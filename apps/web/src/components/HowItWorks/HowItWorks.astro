---
import Badge from "../Badge.astro";
---

<div class="flex flex-col gap-2 max-md:justify-self-center">
  <Badge text="How it works" />
  <div class="max-w-60">
    <p class="text-xl font-bold">Three simple steps</p>
    <p class="text-xs">
      Get your celebration up and running in just a few minutes.
    </p>
  </div>
  <ol>
    <li>
      <span class="number bg-primary/25"> 1 </span>
      <div class="detail">
        <p>Create your event</p>
        <p>Set up a exchange or celebration.</p>
      </div>
    </li>
    <li>
      <span class="number bg-primary/25"> 2 </span>
      <div class="detail">
        <p>Invite your people</p>
        <p>Share a link or send invites.</p>
      </div>
    </li>
    <li>
      <span class="number bg-primary/25"> 3 </span>
      <div class="detail">
        <p>Enjoy the festivities</p>
        <p>Let All Things Gift handle rest.</p>
      </div>
    </li>
  </ol>
</div>

<style>
  ol {
    --list-gap: 2rem;
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    gap: var(--list-gap);
  }

  li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  span.number {
    position: relative;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    font-weight: var(--font-weight-semibold);
    /* Opaque base plus the tint. A transparent fill would show the line through the badge. */
    border-radius: var(--radius-lg);
    height: 2.5rem;
    aspect-ratio: 1;
    color: var(--primary);
  }

  li:not(:last-child) .number::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    height: var(--list-gap);
    width: 1px;
    background-color: var(--border);
    opacity: 0.5;
    z-index: -1;
  }

  .detail {
    p:first-of-type {
      font-size: var(--text-sm);
      font-weight: var(--font-weight-semibold);
    }
    p:last-of-type {
      font-size: var(--text-xs);
    }
  }
</style>

---
import { buttonVariants } from "@allthingsgift/ui/components/button";
import { ArrowRight } from "@lucide/astro";
---

<div
  class="relative flex flex-col md:flex-row bg-primary/25 w-full rounded-lg p-10 gap-10 max-w-250 mx-auto overflow-hidden"
>
  <div class="flex flex-col gap-2 z-1">
    <p class="font-bold text-2xl">Ready to make someone's day?</p>
    <p class="text-sm">
      Start a gift exchange, plan a celebration, or create a wishlist today.
    </p>
  </div>
  <a href="/" class={buttonVariants({ className: "px-5 z-1" })}>
    Get started free
    <ArrowRight />
  </a>
  <img
    src="/banner-gifts.svg"
    class="absolute inset-0 h-50 left-full -translate-x-full z-0 max-md:opacity-50"
  />
</div>

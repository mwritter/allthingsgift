POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Host-run API and goose (pnpm db:migrate). Inside Compose the host is `db`.
DATABASE_URL=

# Email via Resend. Leave RESEND_API_KEY unset to print login codes and invites
# to the API log instead. Keep MAIL_FROM quoted: .env is sourced by sh.
# RESEND_API_KEY=re_...
# MAIL_FROM=""
